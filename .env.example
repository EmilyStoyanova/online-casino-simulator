# -----------------------------------------------------------------------------
# Online Casino Simulator — local environment configuration
#
# Copy this file to `.env` (which is git-ignored) and adjust the values:
#     cp .env.example .env
#
# `.env` is read by Docker Compose (database container) and imported by the
# Spring Boot backend via `spring.config.import`. Never commit real secrets.
# -----------------------------------------------------------------------------

# --- PostgreSQL container (docker-compose.yml) -------------------------------
POSTGRES_DB=casino
POSTGRES_USER=casino
POSTGRES_PASSWORD=change-me-local-only
# Host port the database is published on.
POSTGRES_PORT=5432

# --- Backend (Spring Boot) ---------------------------------------------------
# Must point at the database above. In production these come from the hosting
# provider's secret store (e.g. Render + Neon), never from a committed file.
DB_URL=jdbc:postgresql://localhost:5432/casino
DB_USERNAME=casino
DB_PASSWORD=change-me-local-only

SERVER_PORT=8080
# Comma-separated list of browser origins allowed to call the API. Keep the Vite dev
# origin: the browser sends it on unsafe requests even through the dev proxy.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Sessions and security (defaults shown; production values in comments) ----
# Session cookie: production `__Host-SESSION` and `true` (requires HTTPS).
APP_SESSION_COOKIE_NAME=SESSION
APP_SESSION_COOKIE_SECURE=false
APP_SESSION_COOKIE_SAME_SITE=lax
# Inactivity timeout of a session.
APP_SESSION_TIMEOUT=30m
# BCrypt cost (at least 10).
APP_SECURITY_BCRYPT_STRENGTH=12
# REQUIRED. HMAC key of the login/registration throttle counters: Base64, at least 32 random bytes.
# The backend does not start without a valid value. Generate your own; never reuse or commit it:
#     openssl rand -base64 32
# Paste it without quotes: the backend reads this file as properties and would keep them.
# Production: a different value, stored only in the hosting provider's secret store. Changing it
# resets all throttle counters (see docs/database.md, "Throttling secret").
APP_SECURITY_THROTTLE_SECRET=
# Forwarded headers are ignored by default (client IP = TCP peer). `native` is only accepted together
# with an explicit SERVER_TOMCAT_REMOTEIP_INTERNAL_PROXIES (the platform's proxies); `framework` is rejected.
SERVER_FORWARD_HEADERS_STRATEGY=none
