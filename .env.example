# -----------------------------------------------------------------------------
# Online Casino Simulator — local environment configuration
#
# Copy this file to `.env` (which is git-ignored) and adjust the values:
#     cp .env.example .env
#
# `.env` is read by Docker Compose (database container) and imported by the
# Spring Boot backend via `spring.config.import`. Never commit real secrets.
# -----------------------------------------------------------------------------

# --- PostgreSQL container (docker-compose.yml) -------------------------------
POSTGRES_DB=casino
POSTGRES_USER=casino
POSTGRES_PASSWORD=change-me-local-only
# Host port the database is published on.
POSTGRES_PORT=5432

# --- Backend (Spring Boot) ---------------------------------------------------
# Must point at the database above. In production these come from the hosting
# provider's secret store (e.g. Render + Neon), never from a committed file.
DB_URL=jdbc:postgresql://localhost:5432/casino
DB_USERNAME=casino
DB_PASSWORD=change-me-local-only

SERVER_PORT=8080
# Comma-separated list of browser origins allowed to call the API.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
