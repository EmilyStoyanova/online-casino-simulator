# Copy to `.env.local` (git-ignored) to override defaults.
# Only variables prefixed with VITE_ are exposed to browser code — never put secrets here.

# Base URL of the backend API. Leave empty in development: requests go to `/api/...`
# on the Vite dev server, which proxies them to VITE_DEV_PROXY_TARGET.
# In production set it to the public backend URL, e.g. https://api.example.org
VITE_API_BASE_URL=

# Where the Vite dev server forwards `/api` requests (development only).
VITE_DEV_PROXY_TARGET=http://localhost:8080
