# Copy to `.env.local` (git-ignored) to override defaults.
# Only variables prefixed with VITE_ are exposed to browser code — never put secrets here.

# Base URL of the backend API. Leave empty: requests go to `/api/...` on the page's own origin.
# In development the Vite dev server proxies them to VITE_DEV_PROXY_TARGET; on Vercel the rewrite in
# vercel.json forwards them to the backend. A backend on another site breaks cookie sign-in.
VITE_API_BASE_URL=

# Where the Vite dev server forwards `/api` requests (development only).
VITE_DEV_PROXY_TARGET=http://localhost:8080
