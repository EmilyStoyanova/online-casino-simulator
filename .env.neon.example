# -----------------------------------------------------------------------------
# Online Casino Simulator — Neon PostgreSQL connection (profile `neon`)
#
# Copy to `.env.neon` in the repository root (git-ignored) and fill in the values
# in your editor, never in a chat, a prompt or a shell command:
#     cp .env.neon.example .env.neon
#
# Used by the backend only with SPRING_PROFILES_ACTIVE=neon (application-neon.yml),
# and by infrastructure/neon/readonly-query.sh. Without the profile the backend keeps
# using the local Docker database from `.env`. Procedure: docs/database.md, "Neon".
#
# Values from Neon Console → your branch → Connect, with "Connection pooling" OFF
# (direct connection). Write them WITHOUT quotes: both readers keep quotes literally.
# Do not paste the JDBC connection string: it contains the password.
# -----------------------------------------------------------------------------

# Direct endpoint host, e.g. ep-<name>-<id>.eu-central-1.aws.neon.tech
# (NOT the "-pooler" host: Flyway migrations need a direct connection).
NEON_DB_HOST=
# Database on that branch, e.g. neondb
NEON_DB_NAME=
# Role and its password (the password is a secret)
NEON_DB_USERNAME=
NEON_DB_PASSWORD=
